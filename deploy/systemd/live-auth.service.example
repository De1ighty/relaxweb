[Unit]
Description=RelaxWeb Live Stream Auth（拉流鉴权，供 MediaMTX 调用）
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
# 改成你部署这个项目的路径
WorkingDirectory=__APP_DIR__
Environment=HOME=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __APP_DIR__/auth_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
